<!-- Proje dosyası: bu bir ASP.NET Core web uygulaması, .NET 10 hedefliyor. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VeliAkademisi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Veritabanı: SQLite, EF Core ile -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <!-- Excel dosyası üretmek için -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <!-- Yalnızca geliştirme sırasında: şema güncelleme dosyalarını (Veri/Gecisler) üreten araç için.
         Yayımlanan pakete girmez. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Sistem yöneticisinin haftalık yedeği: şifreli (AES-256) zip; Windows'ta 7-Zip ile açılır -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Depodaki hikâye klasörü (icerik/) derlenen çıktıya "icerik" adıyla kopyalanır.
         Sesler depoda olmadığı için hiçbir ses dosyası kopyalanmaz. -->
    <None Include="..\..\icerik\**\*" Exclude="..\..\icerik\**\ses\**" LinkBase="icerik" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
