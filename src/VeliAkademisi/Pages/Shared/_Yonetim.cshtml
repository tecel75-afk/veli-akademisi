<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>@(ViewData["Baslik"] ?? "Yönetim") · Veli Akademisi</title>
  <style>
    /* Sade, telefonda da kullanılabilir görünüm. Renkler hikâye sayfalarıyla aynı aileden. */
    :root{--bg:#EEF2F1;--surface:#FFFFFF;--ink:#1E2B2E;--muted:#5B6B6E;--accent:#1E6B66;--accent-ink:#FFFFFF;
      --line:#D5DEDC;--hata:#A33A2C;--soft:#E2EEEC}
    @@media (prefers-color-scheme: dark){:root{--bg:#121A1B;--surface:#1B2628;--ink:#E8EFEE;--muted:#A3B3B2;
      --accent:#5FB7AE;--accent-ink:#0E1A1A;--line:#2C3A3C;--hata:#F08A7A;--soft:#22322F;color-scheme:dark}}
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,"Segoe UI",sans-serif;font-size:17px;line-height:1.5}
    .kap{max-width:960px;margin:0 auto;padding:16px}
    .ust{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:16px}
    .marka{font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--accent);font-size:14px}
    .ust .sag{margin-left:auto}
    h1{font-size:26px;margin:0 0 12px}
    .kart{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px}
    label{display:block;font-weight:700;margin-bottom:6px}
    input[type=password],input[type=text],textarea{width:100%;font:inherit;padding:10px 12px;border:1px solid var(--line);
      border-radius:10px;background:var(--surface);color:var(--ink)}
    .btn{font:inherit;font-weight:800;border:0;border-radius:10px;padding:10px 16px;background:var(--accent);color:var(--accent-ink);cursor:pointer}
    .btn.ikincil{background:var(--soft);color:var(--ink)}
    .hata{color:var(--hata);font-weight:700}
    .not{color:var(--muted);font-size:15px}
    :focus-visible{outline:3px solid var(--accent);outline-offset:2px}
  </style>
</head>
<body>
  <div class="kap">
    @RenderBody()
  </div>
</body>
</html>
