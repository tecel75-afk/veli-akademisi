<!-- Proje dosyası: bu bir ASP.NET Core web uygulaması, .NET 10 hedefliyor. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VeliAkademisi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Veritabanı: SQLite, EF Core ile -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Depodaki hikâye klasörü (icerik/) derlenen çıktıya "icerik" adıyla kopyalanır.
         Sesler depoda olmadığı için hiçbir ses dosyası kopyalanmaz. -->
    <None Include="..\..\icerik\**\*" Exclude="..\..\icerik\**\ses\**" LinkBase="icerik"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
