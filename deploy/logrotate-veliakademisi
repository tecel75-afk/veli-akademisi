# Veli Akademisi · nginx günlükleri 7 gün tutulur (KVKK, tanım bölüm 10).
/var/log/nginx/veliakademisi-*.gunluk {
    daily
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        [ -s /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)" || true
    endscript
}
